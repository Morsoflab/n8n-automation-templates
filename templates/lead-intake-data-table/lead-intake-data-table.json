      "name": "Find Possible Duplicate",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const incoming = $('Classify Replay').first().json;\nconst normalizeText = value => String(value ?? '').trim().toLowerCase().replace(/\\s+/g, ' ');\n// ponytail: scans the table once; move identity controls into the database when volume or concurrency requires it.\nconst possibleMatch = $input.all()\n  .map(item => item.json)\n  .filter(row => row.id !== undefined && row.id !== null)\n  .find(row => row.email === incoming.email || (incoming.phone && row.phone === incoming.phone));\nconst duplicateSignals = [];\n\nif (possibleMatch?.email === incoming.email) duplicateSignals.push('email');\nif (incoming.phone && possibleMatch?.phone === incoming.phone) duplicateSignals.push('phone');\nif (possibleMatch && incoming.name && normalizeText(possibleMatch.name) === normalizeText(incoming.name)) duplicateSignals.push('name');\nif (possibleMatch && incoming.company && normalizeText(possibleMatch.company) === normalizeText(incoming.company)) duplicateSignals.push('company');\n\nreturn [{ json: {\n  ...incoming,\n  possibleDuplicateOf: possibleMatch ? String(possibleMatch.id) : '',\n  duplicateSignals: duplicateSignals.join(','),\n  status: possibleMatch ? 'manual_review' : 'pending',\n} }];"
      },
