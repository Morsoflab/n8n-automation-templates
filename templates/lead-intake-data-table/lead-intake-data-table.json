        "jsCode": "const incoming = $('Hash Normalized Payload').item.json;\nconst existing = $json ?? {};\nconst exists = existing.id !== undefined && existing.id !== null;\nconst conflict = exists && existing.payload_hash !== incoming.payloadHash;\nreturn { json: { ...incoming, exists, conflict, existingLeadId: exists ? existing.lead_id : null } };"
