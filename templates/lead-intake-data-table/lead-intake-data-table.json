      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const input = $json.body ?? {};\nconst headers = $json.headers ?? {};\n\nconst idempotencyKey = String(\n  headers['idempotency-key']\n  ?? headers['x-idempotency-key']\n  ?? input.idempotencyKey\n  ?? ''\n).trim();\n\nconst name = String(input.name ?? '').trim().slice(0, 200);\nconst email = String(input.email ?? '').trim().toLowerCase().slice(0, 320);\nconst company = String(input.company ?? '').trim().slice(0, 200);\nconst message = String(input.message ?? '').trim().slice(0, 5000);\nconst source = String(input.source ?? 'website').trim().slice(0, 100);\nconst errors = [];\n\nif (!idempotencyKey) errors.push('An Idempotency-Key header is required');\nif (idempotencyKey.length > 200) errors.push('The idempotency key must not exceed 200 characters');\nif (!email || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) errors.push('A valid email is required');\n\nconst normalizedPayload = JSON.stringify({ name, email, company, message, source });\n\nreturn { json: { valid: errors.length === 0, errors, idempotencyKey, name, email, company, message, source, normalizedPayload } };"
      },
      "type": "n8n-nodes-base.code",
