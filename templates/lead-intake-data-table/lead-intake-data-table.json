      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const IDEMPOTENCY_TTL_HOURS = 24; // Change this value to configure key lifetime.\nconst input = $json.body ?? {};\nconst headers = $json.headers ?? {};\n\nconst idempotencyKey = String(\n  headers['idempotency-key']\n  ?? headers['x-idempotency-key']\n  ?? input.idempotencyKey\n  ?? ''\n).trim();\n\nconst name = String(input.name ?? '').trim().slice(0, 200);\nconst email = String(input.email ?? '').trim().toLowerCase().slice(0, 320);\nconst rawPhone = String(input.phone ?? '').trim();\nconst phoneDigits = rawPhone.replace(/\\D/g, '');\nconst phone = (phoneDigits.startsWith('00') ? phoneDigits.slice(2) : phoneDigits).slice(0, 30);\nconst company = String(input.company ?? '').trim().slice(0, 200);\nconst message = String(input.message ?? '').trim().slice(0, 5000);\nconst source = String(input.source ?? 'website').trim().slice(0, 100);\nconst receivedAt = new Date();\nconst expiresAt = new Date(receivedAt.getTime() + IDEMPOTENCY_TTL_HOURS * 60 * 60 * 1000);\nconst errors = [];\n\nif (!idempotencyKey) errors.push('An Idempotency-Key header is required');\nif (idempotencyKey.length > 200) errors.push('The idempotency key must not exceed 200 characters');\nif (!email || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) errors.push('A valid email is required');\n\nconst payloadForHash = { name, email, company, message, source };\nif (phone) payloadForHash.phone = phone;\nconst normalizedPayload = JSON.stringify(payloadForHash);\n\nreturn { json: { valid: errors.length === 0, errors, idempotencyKey, name, email, phone, company, message, source, normalizedPayload, receivedAt: receivedAt.toISOString(), expiresAt: expiresAt.toISOString() } };"
      },
